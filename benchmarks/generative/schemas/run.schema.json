{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chroma3d.local/cgb/0.1/run.schema.json",
  "title": "CGB Generation Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "cgb_version", "timestamp", "case_id", "track", "backend_id", "provider", "model_version", "backend_version_source", "input_hashes", "attempt", "seed", "parameters", "request_parameter_hash", "quality_mode", "task_id", "status", "error_class", "latency", "credits", "estimated_cost_usd", "raw_artifact_sha256", "raw_artifact_format", "raw_artifact_path", "raw_metrics_path", "conditioned_metrics_path", "alignment", "environment", "gpu", "driver", "notes", "cache_key", "cache_identity", "resumed", "dry_run"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "cgb_version": {"const": "0.1.0"},
    "timestamp": {"type": "string", "format": "date-time"},
    "case_id": {"type": "string"},
    "track": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]},
    "backend_id": {"type": "string"},
    "provider": {"type": "string"},
    "model_version": {"type": "string"},
    "backend_version_source": {"type": "string"},
    "input_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "attempt": {"type": "integer", "minimum": 1},
    "seed": {"type": ["integer", "null"]},
    "parameters": {"type": "object"},
    "request_parameter_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quality_mode": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "status": {"enum": ["PASS", "GENERATION_FAILED", "PROVIDER_ERROR", "TIMEOUT", "INVALID_ARTIFACT", "IMPORT_FAILED", "ANALYSIS_FAILED", "ALIGNMENT_INDETERMINATE", "UNSUPPORTED_TRACK", "MISSING_CREDENTIAL", "SPEND_NOT_AUTHORIZED", "MODEL_NOT_INSTALLED", "INSUFFICIENT_HARDWARE", "VERSION_UNVERIFIED", "NOT_RUN"]},
    "error_class": {"type": ["string", "null"]},
    "latency": {"type": "object"},
    "credits": {"type": ["number", "null"]},
    "estimated_cost_usd": {"type": ["number", "null"]},
    "cost_state": {"enum": ["KNOWN", "ESTIMATED", "UNKNOWN"]},
    "raw_artifact_sha256": {"type": ["string", "null"]},
    "raw_artifact_format": {"type": ["string", "null"]},
    "raw_artifact_path": {"type": ["string", "null"]},
    "raw_metrics_path": {"type": ["string", "null"]},
    "conditioned_metrics_path": {"type": ["string", "null"]},
    "alignment": {"type": ["object", "null"]},
    "environment": {"type": "object"},
    "gpu": {},
    "driver": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cache_identity": {"type": "object"},
    "resumed": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "provider_metadata": {"type": "object"},
    "evaluation_cache_identity": {"type": "object"},
    "raw_metrics": {"type": "object"},
    "conditioning": {"type": "object"},
    "conditioned_geometry_metrics_path": {"type": "string"},
    "conditioned_evaluation_cache_identity": {"type": "object"},
    "conditioning_fidelity_drift": {"type": "number"},
    "source_immutable": {"type": "boolean"},
    "error": {"type": "string"}
  }
}
