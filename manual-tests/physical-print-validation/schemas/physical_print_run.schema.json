{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriramNavi/Chroma3D-Sculpt/schemas/physical-print-run-1.0.0.json",
  "title": "Chroma3D physical print run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "state", "created_at", "model", "hardware",
    "print_setup", "predictions", "slicer_evidence", "evidence", "observation_file",
    "overall_disposition"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^P35-[0-9]{2}-[a-z0-9-]+$"},
    "state": {"enum": ["PLANNED", "READY", "IN_PROGRESS", "OBSERVED", "INVALID"]},
    "created_at": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_version", "model_id", "title", "license", "source_url", "source_path", "raw_sha256", "triangle_count", "size_class", "target_height_mm", "unit_confirmation"],
      "properties": {
        "dataset_version": {"const": "1.0.0"}, "model_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "triangle_count": {"type": "integer", "minimum": 1}, "size_class": {"enum": ["TINY", "SMALL", "MEDIUM", "LARGE", "HUGE", "EXTREME"]},
        "target_height_mm": {"type": "number", "exclusiveMinimum": 0},
        "unit_confirmation": {"enum": ["REQUIRED", "CONFIRMED"]}
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["printer", "nozzle_mm", "material", "filament_batch", "build_plate_type", "bed_preparation"],
      "properties": {
        "printer": {"const": "Bambu Lab X1 Carbon"}, "nozzle_mm": {"type": "number", "exclusiveMinimum": 0},
        "material": {"type": "string", "minLength": 1}, "filament_batch": {"type": ["string", "null"]},
        "build_plate_type": {"type": "string", "minLength": 1}, "bed_preparation": {"type": "string", "minLength": 1}
      }
    },
    "print_setup": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "layer_height_mm", "scale_percent", "orientation", "supports", "support_settings_summary", "estimated_duration_minutes", "estimated_material_grams"],
      "properties": {
        "profile_id": {"const": "bambu_x1_carbon"}, "layer_height_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "scale_percent": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "orientation": {"type": "object", "required": ["source", "rotation_degrees"], "additionalProperties": false, "properties": {"source": {"enum": ["CURRENT", "CHROMA3D_RECOMMENDATION", "SLICER_USER_PREFERRED", "TO_BE_RECORDED"]}, "rotation_degrees": {"type": ["array", "null"], "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}}},
        "supports": {"enum": ["ENABLED", "DISABLED", "TO_BE_RECORDED"]},
        "support_settings_summary": {"type": "string", "minLength": 1},
        "estimated_duration_minutes": {"type": ["number", "null"], "minimum": 0},
        "estimated_material_grams": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "predictions": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_fingerprint", "profile_id", "mode", "score", "status", "confidence", "check_states", "critical_risks", "warning_risks", "skipped_checks", "engine_report_json", "engine_report_markdown"],
      "properties": {
        "implementation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string"},
        "mode": {"enum": ["FAST", "STANDARD", "DEEP"]}, "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "status": {"type": "string", "minLength": 1}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "check_states": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "critical_risks": {"type": "array", "items": {"type": "string"}}, "warning_risks": {"type": "array", "items": {"type": "string"}},
        "skipped_checks": {"type": "array", "items": {"type": "string"}},
        "engine_report_json": {"type": ["string", "null"]}, "engine_report_markdown": {"type": ["string", "null"]}
      }
    },
    "slicer_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "slicer", "version", "settings_export", "screenshots", "warnings"],
      "properties": {
        "state": {"enum": ["NOT_RUN", "MANUAL", "AUTOMATED"]}, "slicer": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]},
        "settings_export": {"type": ["string", "null"]}, "screenshots": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "object", "required": ["engine_screenshots", "photo_manifest"], "additionalProperties": false, "properties": {"engine_screenshots": {"type": "array", "items": {"type": "string"}}, "photo_manifest": {"type": ["string", "null"]}}},
    "observation_file": {"type": ["string", "null"]},
    "overall_disposition": {"enum": ["SUCCESS", "SUCCESS_WITH_MINOR_DEFECTS", "PARTIAL_FAILURE", "FAILURE", "INVALID_EXPERIMENT", "NOT_RUN"]}
  }
}
