{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriramNavi/Chroma3D-Sculpt/schemas/advanced-preparation-report-1.0.json",
  "title": "Chroma3D Advanced Print Preparation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_schema_version", "extension_version", "preparation_run_id", "analyzed_at", "object_metadata", "geometry_signature", "transform_signature", "source_signature", "process_context_snapshot", "feature_flags", "performance_registry_version", "performance_mode", "base_printability", "bridge_risk", "support_risk", "resin_advisory", "scale_recommendation", "orientation_comparison", "score", "status", "confidence", "timings", "skipped_checks", "failed_checks", "warnings", "limitations", "stale_state"],
  "properties": {
    "report_schema_version": {"const": "1.0"}, "extension_version": {"type": "string"}, "preparation_run_id": {"type": "string"},
    "analyzed_at": {"type": "string", "format": "date-time"}, "object_metadata": {"type": "object"},
    "geometry_signature": {"type": "string"}, "transform_signature": {"type": "string"}, "source_signature": {"type": "string"},
    "process_context_snapshot": {"type": "object"}, "feature_flags": {"type": "object"}, "performance_registry_version": {"const": "1.0.0"},
    "performance_mode": {"enum": ["FAST", "STANDARD", "DEEP"]}, "base_printability": {"type": "object"},
    "bridge_risk": {"type": "object"}, "support_risk": {"type": "object"}, "resin_advisory": {"type": "object"},
    "scale_recommendation": {"type": "object"}, "orientation_comparison": {"type": "object"},
    "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "status": {"enum": ["PASS", "WARNING", "CRITICAL", "NOT_EVALUATED", "NOT_APPLICABLE", "SKIPPED_LIMIT", "INDETERMINATE", "FAILED"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}, "timings": {"type": "object"},
    "skipped_checks": {"type": "array", "items": {"type": "object"}}, "failed_checks": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}},
    "stale_state": {"enum": ["CURRENT", "STALE_GEOMETRY", "STALE_TRANSFORM", "STALE_HARDWARE_PROFILE", "STALE_MATERIAL_PROFILE", "STALE_PROCESS_CONTEXT", "STALE_FEATURE_FLAGS", "STALE_PERFORMANCE_POLICY", "STALE_BASELINE", "STALE_BATCH_RESULT"]}
  }
}
