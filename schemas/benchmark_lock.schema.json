{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriramNavi/Chroma3D-Sculpt/schemas/benchmark-lock-1.0.0.json",
  "title": "Chroma3D benchmark lock",
  "type": "object",
  "required": ["schema_version", "benchmark_version", "dataset_version_dependency", "release_url", "asset_filename", "asset_size_bytes", "asset_sha256", "manifest_sha256"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "benchmark_version": { "const": "1.0.0" },
    "dataset_version_dependency": { "const": "1.0.0" },
    "release_url": { "type": "string", "pattern": "^https://github.com/SriramNavi/Chroma3D-Benchmark-Dataset/releases/" },
    "asset_filename": { "type": "string" },
    "asset_size_bytes": { "type": "integer", "minimum": 1 },
    "asset_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
