{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chroma3d://schemas/intelligent-optimization-audit/1.0",
  "title": "Chroma3D Sculpt Intelligent Optimization Audit",
  "type": "object",
  "required": ["schema_version", "extension_version", "exported_at", "source_identity", "source_signature", "search_policy", "constraints", "budget", "strategy_set", "evaluations", "pareto_frontier", "rankings", "advisory_disclaimer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "extension_version": {"type": "string"},
    "blender_version": {"type": "string"},
    "exported_at": {"type": "string"},
    "source_identity": {"type": "object"},
    "source_signature": {"type": "string"},
    "hardware_profile_hash": {"type": "string"},
    "material_profile_hash": {"type": "string"},
    "process_context_hash": {"type": "string"},
    "feature_flag_hash": {"type": "string"},
    "performance_registry_version": {"type": "string"},
    "sprint5_policy": {"type": "object"},
    "sprint5_objectives": {"type": "object"},
    "sprint5_candidates": {"type": "object"},
    "search_policy": {"type": "object"},
    "constraints": {"type": "object"},
    "budget": {"type": "object"},
    "strategy_set": {"type": "object"},
    "evaluations": {"type": "array"},
    "pareto_frontier": {"type": "object"},
    "rankings": {"type": "array"},
    "recommendation": {"type": ["object", "null"]},
    "explanations": {"type": "array"},
    "selected_strategy_id": {"type": "string"},
    "preview_execution_audit": {"type": "array"},
    "sprint5_audit": {"type": "object"},
    "history": {"type": "object"},
    "stale_events": {"type": "array"},
    "cancellation_events": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "skipped_evidence": {"type": "array", "items": {"type": "string"}},
    "advisory_disclaimer": {"type": "string", "minLength": 1}
  }
}
