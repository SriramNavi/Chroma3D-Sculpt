{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriramNavi/Chroma3D-Sculpt/schemas/printability-baseline-1.0.json",
  "title": "Chroma3D Printability Baseline 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "baseline_version", "status", "generated_at", "software", "dataset", "golden_benchmark", "process_context", "feature_flags", "records", "physical_validation_status", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"}, "baseline_version": {"const": "1.0.0"}, "status": {"enum": ["PROPOSED", "VALIDATED", "FROZEN"]},
    "generated_at": {"type": "string", "format": "date-time"}, "software": {"type": "object"},
    "dataset": {"type": "object"}, "golden_benchmark": {"type": "object"}, "process_context": {"type": "object"},
    "feature_flags": {"type": "object"}, "records": {"type": "array", "items": {"type": "object"}},
    "physical_validation_status": {"const": "READY_FOR_PHYSICAL_EXECUTION"}, "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
