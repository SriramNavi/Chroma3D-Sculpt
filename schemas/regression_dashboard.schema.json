{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriramNavi/Chroma3D-Sculpt/schemas/regression-dashboard-1.0.json",
  "title": "Chroma3D regression dashboard summary",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "overall_state", "model_count", "pass_count", "warning_count", "fail_count", "review_required_count", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "overall_state": {"enum": ["PASS", "WARNING", "FAIL", "REVIEW_REQUIRED"]},
    "model_count": {"type": "integer", "minimum": 0}, "pass_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0}, "fail_count": {"type": "integer", "minimum": 0},
    "review_required_count": {"type": "integer", "minimum": 0}, "generated_at": {"type": "string", "format": "date-time"}
  }
}
