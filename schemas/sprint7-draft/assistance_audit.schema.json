{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chroma3d://schemas/sprint7-draft/assistance-audit/0.1.0-draft",
  "title": "Chroma3D Sprint 7 Draft Assistance Audit",
  "$comment": "DRAFT ONLY. Full bounded audit projection with redacted provider exchange summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "schema_version", "extension_version", "exported_at", "audit_id", "session", "source_identity", "settings_snapshot", "profile_hashes", "consent", "context", "provider_exchange", "validation", "recommendations", "selection", "preview", "approval", "operations", "checkpoints", "comparison", "stale_events", "cancellation_events", "failures", "recovery", "cleanup", "runtime", "memory_observations", "usage", "warnings", "skipped_checks", "evidence_states", "provenance", "limitations", "disclaimers"],
  "properties": {
    "draft": {"const": true},
    "schema_version": {"const": "0.1.0-draft"},
    "extension_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "exported_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "audit_id": {"$ref": "#/$defs/id"},
    "session": {"type": "object", "additionalProperties": false, "required": ["session_id", "state", "created_at", "updated_at"], "properties": {"session_id": {"$ref": "#/$defs/id"}, "state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "created_at": {"type": "string", "maxLength": 64}, "updated_at": {"type": "string", "maxLength": 64}}},
    "source_identity": {"type": "object", "additionalProperties": false, "required": ["object_identity", "mesh_identity", "source_signature", "source_unchanged"], "properties": {"object_identity": {"type": "string", "maxLength": 128}, "mesh_identity": {"type": "string", "maxLength": 128}, "source_signature": {"$ref": "#/$defs/hash"}, "source_unchanged": {"type": "boolean"}}},
    "settings_snapshot": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}, "maxProperties": 128},
    "profile_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}, "maxProperties": 32},
    "consent": {"type": "object", "additionalProperties": false, "required": ["consent_id", "approved", "scope_hash", "destination", "data_categories", "purpose", "retention_disclosure", "cost_disclosure"], "properties": {"consent_id": {"type": "string", "maxLength": 96}, "approved": {"type": "boolean"}, "scope_hash": {"$ref": "#/$defs/hash"}, "destination": {"type": "string", "maxLength": 256}, "data_categories": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}, "purpose": {"type": "string", "maxLength": 512}, "retention_disclosure": {"type": "string", "maxLength": 1024}, "cost_disclosure": {"type": "string", "maxLength": 1024}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["context_id", "context_hash", "byte_count", "included_categories", "omitted_categories", "evidence_count", "geometry_elements_exported"], "properties": {"context_id": {"type": "string", "maxLength": 96}, "context_hash": {"$ref": "#/$defs/hash"}, "byte_count": {"type": "integer", "minimum": 0, "maximum": 1048576}, "included_categories": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}, "omitted_categories": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}, "evidence_count": {"type": "integer", "minimum": 0, "maximum": 2048}, "geometry_elements_exported": {"const": 0}}},
    "provider_exchange": {"type": ["object", "null"], "additionalProperties": false, "required": ["exchange_id", "contract_hash", "request_hash", "response_hash", "request_bytes", "response_bytes", "redacted_request_summary", "redacted_response_summary", "status"], "properties": {"exchange_id": {"type": "string", "maxLength": 96}, "contract_hash": {"$ref": "#/$defs/hash"}, "request_hash": {"$ref": "#/$defs/hash"}, "response_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "request_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "response_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "redacted_request_summary": {"type": "string", "maxLength": 4096}, "redacted_response_summary": {"type": "string", "maxLength": 4096}, "status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}}},
    "validation": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["validator", "state", "reason"], "properties": {"validator": {"type": "string", "maxLength": 128}, "state": {"$ref": "#/$defs/evidenceState"}, "reason": {"type": "string", "maxLength": 1024}}}},
    "recommendations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}},
    "selection": {"type": ["object", "null"], "additionalProperties": false, "required": ["recommendation_id", "target_id", "target_fingerprint", "parameter_hash"], "properties": {"recommendation_id": {"type": "string", "maxLength": 96}, "target_id": {"type": "string", "maxLength": 128}, "target_fingerprint": {"$ref": "#/$defs/hash"}, "parameter_hash": {"$ref": "#/$defs/hash"}}},
    "preview": {"$ref": "#/$defs/referenceOrNull"},
    "approval": {"type": "object", "additionalProperties": false, "required": ["required", "approved", "approval_scope_hash", "approved_at"], "properties": {"required": {"type": "boolean"}, "approved": {"type": "boolean"}, "approval_scope_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "approved_at": {"type": ["string", "null"], "maxLength": 64}}},
    "operations": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reference"}},
    "checkpoints": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reference"}},
    "comparison": {"$ref": "#/$defs/referenceOrNull"},
    "stale_events": {"$ref": "#/$defs/eventList"},
    "cancellation_events": {"$ref": "#/$defs/eventList"},
    "failures": {"$ref": "#/$defs/eventList"},
    "recovery": {"$ref": "#/$defs/eventList"},
    "cleanup": {"$ref": "#/$defs/eventList"},
    "runtime": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["phase", "seconds", "classification"], "properties": {"phase": {"type": "string", "maxLength": 64}, "seconds": {"type": "number", "minimum": 0, "maximum": 86400}, "classification": {"enum": ["LOCAL_MEASURED", "PROVIDER_REPORTED", "ESTIMATED"]}}}},
    "memory_observations": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["phase", "megabytes", "classification"], "properties": {"phase": {"type": "string", "maxLength": 64}, "megabytes": {"type": "number", "minimum": 0}, "classification": {"const": "POINT_OBSERVATION"}}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["classification", "input_units", "output_units", "cost_amount", "currency"], "properties": {"classification": {"enum": ["MEASURED", "PROVIDER_REPORTED", "ESTIMATED", "UNAVAILABLE"]}, "input_units": {"type": ["integer", "null"], "minimum": 0}, "output_units": {"type": ["integer", "null"], "minimum": 0}, "cost_amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}}},
    "warnings": {"$ref": "#/$defs/textList"},
    "skipped_checks": {"$ref": "#/$defs/textList"},
    "evidence_states": {"$ref": "#/$defs/evidenceStates"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "disclaimers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[0-9a-f-]{32,64}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceState": {"enum": ["PASS", "WARNING", "FAIL", "SKIPPED_LIMIT", "NOT_EVALUATED", "INDETERMINATE", "NOT_APPLICABLE", "STALE", "CANCELLED", "BUDGET_EXHAUSTED"]},
    "evidenceStates": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceState"}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "state", "hash", "limitations"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "state": {"$ref": "#/$defs/evidenceState"}, "hash": {"$ref": "#/$defs/hash"}, "limitations": {"$ref": "#/$defs/limitations"}}},
    "referenceOrNull": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
    "eventList": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "timestamp", "phase", "state", "reason"], "properties": {"event_id": {"type": "string", "maxLength": 96}, "timestamp": {"type": "string", "maxLength": 64}, "phase": {"type": "string", "maxLength": 64}, "state": {"$ref": "#/$defs/evidenceState"}, "reason": {"type": "string", "maxLength": 1024}}}},
    "textList": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "classification"], "properties": {"source_id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"enum": ["LOCAL_MEASURED", "PROVIDER_REPORTED", "ESTIMATED", "REPOSITORY_CONTRACT", "USER_ACTION"]}}}}
  }
}
