{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chroma3d://schemas/sprint7-draft/assistance-policy/0.1.0-draft",
  "title": "Chroma3D Sprint 7 Draft Assistance Policy",
  "$comment": "DRAFT ONLY. Not a packaged runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "schema_version", "policy_id", "policy_version", "deployment_state", "provider_contract_id", "modes", "context_categories", "allowed_actions", "operation_tiers", "consent_policy", "redaction_policy", "retention_policy", "prompt_template_version", "recommendation_schema_version", "performance_registry_version", "policy_hash", "evidence_states", "provenance", "limitations"],
  "properties": {
    "draft": {"const": true},
    "schema_version": {"const": "0.1.0-draft"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "deployment_state": {"enum": ["DISABLED", "TEST_ONLY", "APPROVED_LOCAL", "APPROVED_BYOK", "APPROVED_HOSTED"]},
    "provider_contract_id": {"type": ["string", "null"], "maxLength": 128},
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FAST", "STANDARD", "DEEP", "CUSTOM_MAXIMA"],
      "properties": {
        "FAST": {"$ref": "#/$defs/limits"},
        "STANDARD": {"$ref": "#/$defs/limits"},
        "DEEP": {"$ref": "#/$defs/limits"},
        "CUSTOM_MAXIMA": {"$ref": "#/$defs/limits"}
      }
    },
    "context_categories": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["SOURCE_IDENTITY", "DIAGNOSTIC_SUMMARY", "PRINTABILITY_SUMMARY", "PROCESS_CONTEXT", "OPTIMIZATION_CANDIDATES", "INTELLIGENT_STRATEGIES", "CONSTRAINTS", "RANKING", "USER_INTENT"]}},
    "allowed_actions": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["NO_ACTION", "REQUEST_FRESH_ANALYSIS", "RECOMMEND_EXISTING_CANDIDATE", "RECOMMEND_EXISTING_STRATEGY"]}},
    "operation_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe", "gated", "prohibited"],
      "properties": {
        "safe": {"$ref": "#/$defs/operations"},
        "gated": {"$ref": "#/$defs/operations"},
        "prohibited": {"$ref": "#/$defs/operations"}
      }
    },
    "consent_policy": {"$ref": "#/$defs/namedPolicy"},
    "redaction_policy": {"$ref": "#/$defs/namedPolicy"},
    "retention_policy": {"$ref": "#/$defs/namedPolicy"},
    "prompt_template_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "recommendation_schema_version": {"const": "0.1.0-draft"},
    "performance_registry_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "evidence_states": {"$ref": "#/$defs/evidenceStates"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_bytes", "intent_bytes", "response_bytes", "recommendations", "evidence_links", "json_depth", "local_wall_seconds", "provider_timeout_seconds", "automatic_retries", "report_bytes", "geometry_elements_exported"],
      "properties": {
        "context_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "intent_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "response_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "recommendations": {"type": "integer", "minimum": 1, "maximum": 32},
        "evidence_links": {"type": "integer", "minimum": 1, "maximum": 2048},
        "json_depth": {"type": "integer", "minimum": 4, "maximum": 32},
        "local_wall_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "provider_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "automatic_retries": {"const": 0},
        "report_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "geometry_elements_exported": {"const": 0}
      }
    },
    "operations": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["UNIFORM_SCALE", "ORIENTATION", "BUILD_PLATE_TRANSLATION", "BASE_STABILIZATION", "REPAIR_REUSE", "DECIMATION", "COMBINED_SCALE_ORIENTATION", "EXPERIMENTAL_REMESH"]}},
    "namedPolicy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "version", "hash"], "properties": {"policy_id": {"type": "string", "minLength": 1, "maxLength": 64}, "version": {"type": "string", "minLength": 1, "maxLength": 32}, "hash": {"$ref": "#/$defs/hash"}}},
    "evidenceStates": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["PASS", "WARNING", "FAIL", "SKIPPED_LIMIT", "NOT_EVALUATED", "INDETERMINATE", "NOT_APPLICABLE", "STALE", "CANCELLED", "BUDGET_EXHAUSTED"]}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "classification", "claim"], "properties": {"source_id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"enum": ["REPOSITORY_CONTRACT", "PROJECT_DEFAULT", "OWNER_DECISION", "EXTERNAL_PRIMARY_SOURCE", "MEASURED", "ESTIMATED"]}, "claim": {"type": "string", "minLength": 1, "maxLength": 1024}}}},
    "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  }
}
