{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chroma3d://schemas/sprint7-draft/assistance-report/0.1.0-draft",
  "title": "Chroma3D Sprint 7 Draft Assistance Report",
  "$comment": "DRAFT ONLY. Public report projection; no raw provider body, geometry or Blender references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "schema_version", "extension_version", "exported_at", "report_id", "session_id", "state", "source_identity", "settings", "profile_hashes", "context_summary", "recommendations", "selected_recommendation_id", "resolved_plan_summary", "comparison_summary", "stale_events", "cancellation_events", "runtime", "memory_observations", "usage", "warnings", "skipped_checks", "errors", "evidence_states", "provenance", "limitations", "disclaimers"],
  "properties": {
    "draft": {"const": true},
    "schema_version": {"const": "0.1.0-draft"},
    "extension_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "exported_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "report_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "source_identity": {"type": "object", "additionalProperties": false, "required": ["object_identity", "mesh_identity", "source_signature"], "properties": {"object_identity": {"type": "string", "minLength": 1, "maxLength": 128}, "mesh_identity": {"type": "string", "minLength": 1, "maxLength": 128}, "source_signature": {"$ref": "#/$defs/hash"}}},
    "settings": {"type": "object", "additionalProperties": false, "required": ["mode", "policy_id", "policy_version", "policy_hash", "provider_contract_id", "prompt_template_version"], "properties": {"mode": {"enum": ["FAST", "STANDARD", "DEEP", "CUSTOM"]}, "policy_id": {"type": "string", "minLength": 1, "maxLength": 64}, "policy_version": {"type": "string", "minLength": 1, "maxLength": 32}, "policy_hash": {"$ref": "#/$defs/hash"}, "provider_contract_id": {"type": ["string", "null"], "maxLength": 128}, "prompt_template_version": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "profile_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}, "maxProperties": 32},
    "context_summary": {"type": "object", "additionalProperties": false, "required": ["context_id", "context_hash", "included_categories", "omitted_categories", "evidence_count", "consent_scope_hash"], "properties": {"context_id": {"type": "string", "maxLength": 96}, "context_hash": {"$ref": "#/$defs/hash"}, "included_categories": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}, "omitted_categories": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}}, "evidence_count": {"type": "integer", "minimum": 0, "maximum": 2048}, "consent_scope_hash": {"$ref": "#/$defs/hash"}}},
    "recommendations": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["recommendation_id", "action", "target_id", "confidence", "state", "reason", "assumptions", "unmet_prerequisites", "evidence_links", "limitations"], "properties": {"recommendation_id": {"type": "string", "maxLength": 96}, "action": {"enum": ["NO_ACTION", "REQUEST_FRESH_ANALYSIS", "RECOMMEND_EXISTING_CANDIDATE", "RECOMMEND_EXISTING_STRATEGY"]}, "target_id": {"type": ["string", "null"], "maxLength": 128}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}, "state": {"$ref": "#/$defs/evidenceState"}, "reason": {"type": "string", "minLength": 1, "maxLength": 2048}, "assumptions": {"$ref": "#/$defs/textList"}, "unmet_prerequisites": {"$ref": "#/$defs/textList"}, "evidence_links": {"type": "array", "maxItems": 2048, "items": {"type": "string", "maxLength": 128}}, "limitations": {"$ref": "#/$defs/limitations"}}}},
    "selected_recommendation_id": {"type": ["string", "null"], "maxLength": 96},
    "resolved_plan_summary": {"type": ["object", "null"], "additionalProperties": false, "required": ["target_id", "target_fingerprint", "operation_ids", "parameter_hash", "approval_state"], "properties": {"target_id": {"type": "string", "maxLength": 128}, "target_fingerprint": {"$ref": "#/$defs/hash"}, "operation_ids": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}}, "parameter_hash": {"$ref": "#/$defs/hash"}, "approval_state": {"enum": ["NOT_REQUIRED", "REQUIRED", "APPROVED", "REJECTED", "REVOKED"]}}},
    "comparison_summary": {"type": ["object", "null"], "additionalProperties": false, "required": ["comparison_id", "state", "comparison_hash"], "properties": {"comparison_id": {"type": "string", "maxLength": 128}, "state": {"$ref": "#/$defs/evidenceState"}, "comparison_hash": {"$ref": "#/$defs/hash"}}},
    "stale_events": {"$ref": "#/$defs/eventList"},
    "cancellation_events": {"$ref": "#/$defs/eventList"},
    "runtime": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/metric"}},
    "memory_observations": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["phase", "megabytes", "classification", "process_scope"], "properties": {"phase": {"type": "string", "maxLength": 64}, "megabytes": {"type": "number", "minimum": 0}, "classification": {"const": "POINT_OBSERVATION"}, "process_scope": {"type": "string", "minLength": 1, "maxLength": 128}}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["classification", "input_units", "output_units", "cost_amount", "currency"], "properties": {"classification": {"enum": ["MEASURED", "PROVIDER_REPORTED", "ESTIMATED", "UNAVAILABLE"]}, "input_units": {"type": ["integer", "null"], "minimum": 0}, "output_units": {"type": ["integer", "null"], "minimum": 0}, "cost_amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}}},
    "warnings": {"$ref": "#/$defs/textList"},
    "skipped_checks": {"$ref": "#/$defs/textList"},
    "errors": {"$ref": "#/$defs/textList"},
    "evidence_states": {"$ref": "#/$defs/evidenceStates"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "disclaimers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[0-9a-f-]{32,64}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceState": {"enum": ["PASS", "WARNING", "FAIL", "SKIPPED_LIMIT", "NOT_EVALUATED", "INDETERMINATE", "NOT_APPLICABLE", "STALE", "CANCELLED", "BUDGET_EXHAUSTED"]},
    "evidenceStates": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceState"}},
    "textList": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "eventList": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "timestamp", "kind", "reason", "state"], "properties": {"event_id": {"type": "string", "maxLength": 96}, "timestamp": {"type": "string", "maxLength": 64}, "kind": {"type": "string", "maxLength": 64}, "reason": {"type": "string", "maxLength": 1024}, "state": {"$ref": "#/$defs/evidenceState"}}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["phase", "seconds", "classification"], "properties": {"phase": {"type": "string", "maxLength": 64}, "seconds": {"type": "number", "minimum": 0, "maximum": 86400}, "classification": {"enum": ["LOCAL_MEASURED", "PROVIDER_REPORTED", "ESTIMATED"]}}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "classification"], "properties": {"source_id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"enum": ["LOCAL_MEASURED", "PROVIDER_REPORTED", "ESTIMATED", "REPOSITORY_CONTRACT", "USER_ACTION"]}}}}
  }
}
