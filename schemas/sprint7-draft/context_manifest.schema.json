{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chroma3d://schemas/sprint7-draft/context-manifest/0.1.0-draft",
  "title": "Chroma3D Sprint 7 Draft Context Manifest",
  "$comment": "DRAFT ONLY. Contains summaries and references; geometry arrays and Blender references are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "schema_version", "context_id", "created_at", "purpose", "destination", "source_identity", "source_signature", "dependency_hashes", "included_categories", "omitted_categories", "evidence", "consent", "context_hash", "evidence_states", "provenance", "limitations"],
  "properties": {
    "draft": {"const": true},
    "schema_version": {"const": "0.1.0-draft"},
    "context_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 512},
    "destination": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_identity": {"type": "object", "additionalProperties": false, "required": ["object_name_hash", "mesh_name_hash", "object_identity", "mesh_identity"], "properties": {"object_name_hash": {"$ref": "#/$defs/hash"}, "mesh_name_hash": {"$ref": "#/$defs/hash"}, "object_identity": {"type": "string", "minLength": 1, "maxLength": 128}, "mesh_identity": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "source_signature": {"$ref": "#/$defs/hash"},
    "dependency_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}, "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"}, "maxProperties": 32},
    "included_categories": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}},
    "omitted_categories": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["category", "reason", "state"], "properties": {"category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}, "state": {"$ref": "#/$defs/evidenceState"}}}},
    "summaries": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}, "maxProperties": 128},
    "evidence": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/evidence"}},
    "consent": {"type": "object", "additionalProperties": false, "required": ["consent_id", "approved", "approved_at", "scope_hash", "data_categories", "retention_disclosure", "cost_disclosure"], "properties": {"consent_id": {"$ref": "#/$defs/id"}, "approved": {"type": "boolean"}, "approved_at": {"type": ["string", "null"], "maxLength": 64}, "scope_hash": {"$ref": "#/$defs/hash"}, "data_categories": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}}, "retention_disclosure": {"type": "string", "minLength": 1, "maxLength": 1024}, "cost_disclosure": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "context_hash": {"$ref": "#/$defs/hash"},
    "evidence_states": {"$ref": "#/$defs/evidenceStates"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[0-9a-f-]{32,64}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceState": {"enum": ["PASS", "WARNING", "FAIL", "SKIPPED_LIMIT", "NOT_EVALUATED", "INDETERMINATE", "NOT_APPLICABLE", "STALE", "CANCELLED", "BUDGET_EXHAUSTED"]},
    "evidenceStates": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceState"}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_type", "state", "confidence", "source_report_hash", "provenance", "limitations"], "properties": {"evidence_id": {"type": "string", "minLength": 1, "maxLength": 128}, "evidence_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "state": {"$ref": "#/$defs/evidenceState"}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]}, "source_report_hash": {"$ref": "#/$defs/hash"}, "provenance": {"$ref": "#/$defs/provenance"}, "limitations": {"$ref": "#/$defs/limitations"}}},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "classification"], "properties": {"source_id": {"type": "string", "minLength": 1, "maxLength": 128}, "classification": {"enum": ["MEASURED", "ESTIMATED", "REPOSITORY_CONTRACT", "PROJECT_DEFAULT", "USER_PROVIDED", "PROVIDER_REPORTED"]}}}},
    "limitations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  }
}
